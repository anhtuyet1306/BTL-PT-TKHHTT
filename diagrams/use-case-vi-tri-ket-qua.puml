@startuml
left to right direction
skinparam packageStyle rectangle
skinparam shadowing false

actor "Admin" as Admin
actor "Ứng viên" as UngVien

rectangle "Hệ thống quản lý tuyển dụng" {
  usecase "Xem danh sách\nvị trí" as UC01
  usecase "Xem chi tiết\nvị trí" as UC02
  usecase "Thêm vị trí" as UC03
  usecase "Sửa vị trí" as UC04
  usecase "Xóa/đóng\nvị trí" as UC05
  usecase "Ghi nhận\nkết quả" as UC06
  usecase "Công bố\nkết quả" as UC07
  usecase "Kiểm tra dữ liệu\nhợp lệ" as UC08
  usecase "Kiểm tra dữ liệu\nliên quan" as UC09
}

Admin -- UC01
Admin -- UC02
Admin -- UC03
Admin -- UC04
Admin -- UC05
Admin -- UC06
Admin -- UC07

UngVien -- UC01
UngVien -- UC02

UC03 ..> UC08 : <<include>>
UC04 ..> UC08 : <<include>>
UC05 ..> UC09 : <<include>>
UC06 ..> UC08 : <<include>>
UC07 ..> UC06 : <<extend>>

note bottom of UC01
Ứng viên chỉ thấy vị trí:
- Đang tuyển
- Được bật hiển thị
- Chưa hết hạn
end note
@enduml
